<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnWarning="true"
>
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/Integration</directory>
		</testsuite>
	</testsuites>

	<coverage>
		<include>
			<directory suffix=".php">{{root}}</directory>
			<directory suffix=".php">resources</directory>
		</include>
	</coverage>

	<!--
		tests/Support/ is deliberately outside the suite: the base test case is
		not a test, and a `suffix` narrow enough to exclude it there is one more
		thing to keep in step with a file name.

		The WordPress test suite is located by tests/bootstrap.php -- the
		WP_TESTS_DIR environment variable, which wp-env sets, then the default
		/wordpress-phpunit mount. No path is hard-coded here.
	-->
</phpunit>
