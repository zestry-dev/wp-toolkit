/**
 * Build configuration for {{title}}.
 *
 * Extends the one `@wordpress/scripts` ships, and adds the part it has no
 * opinion about: what to do with your own shared code.
 *
 * A directory under `src/shared/` is an npm workspace, imported by name — so
 * `import { thing } from '@{{slug}}/formatting'` resolves for TypeScript, ESLint
 * and webpack alike, with no path aliases anywhere. Each one says in its own
 * `package.json` how WordPress should load it:
 *
 *     "wordpress": { "kind": "script", "handle": "{{slug}}-formatting", "global": [ "{{slug_camel}}", "formatting" ] }
 *     "wordpress": { "kind": "module" }
 *
 * and this file wires that up. Without it webpack inlines a copy of the code
 * into every entry that imports it; with it, it is built once into
 * `build/shared/` and each entry declares it as a dependency in its own
 * `.asset.php`, exactly as it already does for `@wordpress/element`.
 *
 * `wp zestry make shared <name>` writes one. The `assets` module registers what
 * this produces, so nothing has to call `wp_register_script()` by hand.
 *
 * Generated by `wp zestry init`, and yours to edit — nothing overwrites it.
 */

const { existsSync, readdirSync, readFileSync } = require( 'node:fs' );
const { join } = require( 'node:path' );

const defaults = require( '@wordpress/scripts/config/webpack.config' );
const DependencyExtractionWebpackPlugin = require( '@wordpress/dependency-extraction-webpack-plugin' );
const RemoveEmptyScriptsPlugin = require( 'webpack-remove-empty-scripts' );

/**
 * Where shared packages live, and the directory they are built into.
 *
 * The output segment is read by PHP as well — `Assets::SHARED_SEGMENT` — so the
 * two have to agree. Everything else about the build is `@wordpress/scripts`'.
 */
const SHARED_SEGMENT = 'shared';
const SHARED_DIR = join( __dirname, 'src', SHARED_SEGMENT );

/**
 * Where this plugin's own script entries live, and what they build into.
 *
 * `@wordpress/scripts` has three ways to decide entry points and they are
 * mutually exclusive: files listed on the command line, `block.json` scanning,
 * or the `src/index` fallback. The first two each disable the others, so adding
 * a single block silently stops `src/index` being built and there is no
 * supported way to have both. Merging them is what this config is for.
 *
 * One directory per entry, matching `src/blocks/` and `src/shared/`. Its
 * `index` is the entry; anything it imports — a stylesheet included — comes
 * along.
 */
const ENTRIES_SEGMENT = 'entries';
const ENTRIES_DIR = join( __dirname, 'src', ENTRIES_SEGMENT );
const INDEX_FILES = [ 'index.tsx', 'index.ts', 'index.jsx', 'index.js' ];

/**
 * What an entry with no `index` is built from instead.
 *
 * A directory holding only a stylesheet is a style-only entry: webpack still
 * generates a JavaScript file for it, containing nothing but its own runtime,
 * and `webpack-remove-empty-scripts` deletes that. It recognises the case by
 * every source file reachable from the entry being a stylesheet, which is
 * exactly true when the entry *is* one.
 */
const STYLE_FILES = [
	'style.scss',
	'style.sass',
	'style.css',
	'index.scss',
	'index.sass',
	'index.css',
];

/**
 * The manifests the `assets` module reads, written into the build root.
 *
 * One per compilation, because `--experimental-modules` runs two of them and
 * they emit into the same directory — a single name means whichever finishes
 * last silently discards the other's entries.
 *
 * These names and the segment above are spelled in PHP too, as
 * `Assets::MANIFEST_FILENAMES` and `Assets::SHARED_SEGMENT`.
 */
const MANIFEST_FILENAMES = {
	script: 'assets-manifest.php',
	module: 'assets-module-manifest.php',
};

/**
 * Every workspace package that says how WordPress should load it.
 *
 * @return {Object} Package name => its `wordpress` block, plus where it lives.
 */
function readShared() {
	if ( ! existsSync( SHARED_DIR ) ) {
		return {};
	}

	return readdirSync( SHARED_DIR, { withFileTypes: true } )
		.filter( ( entry ) => entry.isDirectory() )
		.reduce( ( found, entry ) => {
			const manifest = join( SHARED_DIR, entry.name, 'package.json' );

			if ( ! existsSync( manifest ) ) {
				return found;
			}

			const { name, main, wordpress } = JSON.parse(
				readFileSync( manifest, 'utf8' )
			);

			// A package with no `wordpress` block is an ordinary dependency:
			// bundled into whatever imports it, like anything from npm.
			if ( ! name || ! wordpress ) {
				return found;
			}

			return {
				...found,
				[ name ]: {
					...wordpress,
					dir: entry.name,
					entry: join( SHARED_DIR, entry.name, main || 'index.ts' ),
				},
			};
		}, {} );
}

/**
 * Every directory under `src/entries/` that has an index to build.
 *
 * @return {Object} Entry name => the file webpack should start from.
 */
function readEntries() {
	if ( ! existsSync( ENTRIES_DIR ) ) {
		return {};
	}

	return readdirSync( ENTRIES_DIR, { withFileTypes: true } )
		.filter( ( entry ) => entry.isDirectory() )
		.reduce( ( found, entry ) => {
			const [ file ] = [ ...INDEX_FILES, ...STYLE_FILES ]
				.map( ( name ) => join( ENTRIES_DIR, entry.name, name ) )
				.filter( existsSync );

			if ( ! file ) {
				return found;
			}

			/*
			 * An entry is a classic script unless a `package.json` beside it
			 * says otherwise -- the same `wordpress` block a shared package
			 * uses, and needed for the same reason: the two kinds are built by
			 * different compilations and registered through different
			 * WordPress APIs. Only `kind` is read; an entry's handle is not
			 * declared, because this plugin owns it either way.
			 */
			const manifest = join( ENTRIES_DIR, entry.name, 'package.json' );
			const kind = existsSync( manifest )
				? JSON.parse( readFileSync( manifest, 'utf8' ) ).wordpress
						?.kind || 'script'
				: 'script';

			return {
				...found,
				[ `${ ENTRIES_SEGMENT }/${ entry.name }` ]: { file, kind },
			};
		}, {} );
}

const shared = readShared();
const ownEntries = readEntries();

/**
 * Write one PHP manifest describing everything this build produced.
 *
 * PHP cannot read `src/` at run time — that is source, and a shipped plugin
 * need not contain it — so what the build knows has to travel with the output.
 * One `require` of a generated PHP file beats a directory walk plus a read per
 * entry, and it is the same trick `wp-scripts --blocks-manifest` and WordPress
 * core's own block metadata collection already use.
 *
 * Each entry's dependencies and version are the extraction plugin's own, spliced
 * in verbatim rather than recomputed: it already wrote them as a PHP literal in
 * `{entry}.asset.php`, and copying that text is what keeps the two from ever
 * disagreeing. Those per-entry files stay where they are — WordPress reads them
 * itself when it registers a block's scripts.
 *
 * The `assets` module reads this. Without it, that module falls back to the
 * per-entry files and registers no shared packages, since nothing else records
 * which entries are shared or how to load them.
 */
class AssetsManifestPlugin {
	constructor( filename, sharedPackages ) {
		this.filename = filename;
		this.shared = sharedPackages;
	}

	apply( compiler ) {
		const { RawSource } = compiler.webpack.sources;

		compiler.hooks.thisCompilation.tap(
			'AssetsManifestPlugin',
			( compilation ) => {
				compilation.hooks.processAssets.tap(
					{
						name: 'AssetsManifestPlugin',
						// Last, so everything else has finished adding and removing:
						// the extraction plugin emits its asset files at the analyse
						// stage, and empty scripts are dropped after that.
						stage: compilation.constructor
							.PROCESS_ASSETS_STAGE_REPORT,
					},
					() => {
						dropBlankStyles( compilation );

						const entries = {};

						for ( const [
							name,
							entrypoint,
						] of compilation.entrypoints ) {
							const files = entrypoint
								.getFiles()
								.filter( ( file ) =>
									compilation.getAsset( file )
								);
							const js = files.find( ( file ) =>
								file.endsWith( '.js' )
							);
							const css = files.find( ( file ) =>
								file.endsWith( '.css' )
							);

							// Neither survived: a script that was only a stylesheet,
							// and a stylesheet that compiled to nothing.
							if ( ! js && ! css ) {
								continue;
							}

							const rtl =
								css && css.replace( /\.css$/, '-rtl.css' );

							entries[ name ] = {
								...( css ? { css } : {} ),
								...( rtl && compilation.getAsset( rtl )
									? { rtl }
									: {} ),
								// A module entry needs saying; a script one is the
								// default PHP already assumes.
								...( ownEntries[ name ]?.kind === 'module'
									? { kind: 'module' }
									: {} ),
								...( this.shared[ name ] || {} ),
								// Absent for a style-only entry, which is what tells
								// PHP there is no script to register.
								...( js
									? {
											asset: readAssetLiteral(
												compilation,
												js
											),
									  }
									: {} ),
							};
						}

						dropMissingBlockFiles( compilation );

						compilation.emitAsset(
							this.filename,
							new RawSource( renderManifest( entries ) )
						);
					}
				);
			}
		);
	}
}

/**
 * Delete every stylesheet that compiled to nothing.
 *
 * A `.scss` holding only comments, or rules that all resolve away, still emits
 * a file — so a plugin that scaffolded a stylesheet and never filled it in ships
 * an empty one and every page pays for a `<link>` that carries nothing. The
 * generated stylesheet `wp zestry make entry` writes is exactly that until you
 * edit it.
 *
 * Deleting the asset is half of it; the manifest is built afterwards from what
 * survived, so PHP never learns the file existed and never registers it.
 *
 * @param {Object} compilation The webpack compilation.
 * @return {void}
 */
function dropBlankStyles( compilation ) {
	for ( const name of Object.keys( compilation.assets ) ) {
		if ( ! name.endsWith( '.css' ) ) {
			continue;
		}

		if (
			compilation.getAsset( name ).source.source().toString().trim() ===
			''
		) {
			compilation.deleteAsset( name );
		}
	}
}

/**
 * Drop the `file:` fields of a `block.json` whose target is no longer there.
 *
 * A block's own metadata names its scripts and styles, and WordPress registers
 * whatever it names — including a stylesheet that compiled to nothing, which is
 * a `<link>` on every page the block appears on. Editing the copy in the build
 * output is enough: `wp-scripts --blocks-manifest` generates
 * `blocks-manifest.php` after emit, by reading these files back off disk, so it
 * follows without being touched.
 *
 * @param {Object} compilation The webpack compilation.
 * @return {void}
 */
function dropMissingBlockFiles( compilation ) {
	const { RawSource } = compilation.compiler.webpack.sources;

	for ( const name of Object.keys( compilation.assets ) ) {
		if ( ! name.endsWith( 'block.json' ) ) {
			continue;
		}

		const dir = name.replace( /block\.json$/, '' );
		const metadata = JSON.parse(
			compilation.getAsset( name ).source.source().toString()
		);

		// A field may be one reference or several, and a reference may name a
		// handle registered elsewhere rather than a file. Only `file:` ones are
		// this build's to vouch for.
		const survives = ( value ) =>
			typeof value !== 'string' ||
			! value.startsWith( 'file:' ) ||
			Boolean(
				compilation.getAsset(
					dir + value.replace( /^file:\.?\/?/, '' )
				)
			);

		let changed = false;

		for ( const [ field, value ] of Object.entries( metadata ) ) {
			const kept = Array.isArray( value )
				? value.filter( survives )
				: value;

			if (
				Array.isArray( value )
					? kept.length !== value.length
					: ! survives( value )
			) {
				changed = true;

				if ( Array.isArray( value ) && kept.length > 0 ) {
					metadata[ field ] = kept;
				} else {
					delete metadata[ field ];
				}
			}
		}

		if ( changed ) {
			compilation.updateAsset(
				name,
				new RawSource( JSON.stringify( metadata, null, '\t' ) + '\n' )
			);
		}
	}
}

/**
 * One entry's `.asset.php` contents, as the PHP array literal it already is.
 *
 * Extracted rather than parsed: the extraction plugin writes exactly
 * `<?php return <literal>;`, so the boundaries are known and the text in
 * between needs no interpretation to be correct. A file that does not look
 * like that is a change in a tool this build depends on, and saying so here
 * beats emitting a manifest that is quietly wrong.
 *
 * @param {Object} compilation The webpack compilation.
 * @param {string} file        The entry's emitted JavaScript file.
 * @return {string} A PHP array literal.
 */
function readAssetLiteral( compilation, file ) {
	const name = file.replace( /\.m?js$/i, '.asset.php' );
	const asset = compilation.getAsset( name );

	// Built with WP_NO_EXTERNALS, which writes no asset files at all.
	if ( ! asset ) {
		return 'array()';
	}

	const source = asset.source.source().toString();
	const match = source.match( /^<\?php\s+return\s+([\s\S]+);\s*$/ );

	if ( ! match ) {
		throw new Error(
			`Cannot read ${ name }: expected "<?php return <array>;" from ` +
				'@wordpress/dependency-extraction-webpack-plugin.'
		);
	}

	return match[ 1 ];
}

/**
 * A JavaScript string as a single-quoted PHP one.
 *
 * @param {string} value The string to quote.
 * @return {string} PHP source.
 */
function phpString( value ) {
	return (
		"'" +
		String( value ).replace( /\\/g, '\\\\' ).replace( /'/g, "\\'" ) +
		"'"
	);
}

/**
 * The manifest as a PHP file returning an array.
 *
 * @param {Object} entries Entry name => what PHP needs to know about it.
 * @return {string} PHP source.
 */
function renderManifest( entries ) {
	const rows = Object.entries( entries ).flatMap( ( [ name, fields ] ) => {
		const { asset, ...rest } = fields;

		return [
			`\t${ phpString( name ) } => array(`,
			...Object.entries( rest ).map(
				( [ key, value ] ) =>
					`\t\t${ phpString( key ) } => ${ phpString( value ) },`
			),
			// Absent for a style-only entry: there is no script to describe.
			...( asset ? [ `\t\t'asset' => ${ asset },` ] : [] ),
			'\t),',
		];
	} );

	return [
		'<?php',
		'/**',
		' * What the JavaScript build produced, for the `assets` module to register.',
		' *',
		' * Generated by webpack. Do not edit, and do not commit: it is build output.',
		' */',
		'',
		'return array(',
		...rows,
		');',
		'',
	].join( '\n' );
}

/**
 * Add this plugin's shared packages to one of `@wordpress/scripts`' own configurations.
 *
 * There are two of them under `--experimental-modules`: one building classic
 * scripts and one building ES modules. A package belongs to exactly one, so each
 * configuration is given only its own kind — which is also why the externals
 * below cannot cross over, and do not have to guard against it.
 *
 * @param {Object} config One configuration from `@wordpress/scripts`.
 * @return {Object} The same configuration, plus this plugin's shared packages.
 */
function withShared( config ) {
	// Its own answer rather than the array position: this is the field that
	// makes a configuration a module build, so it cannot drift out of step.
	const kind = config.experiments?.outputModule ? 'module' : 'script';
	const mine = Object.entries( shared ).filter(
		( [ , pkg ] ) => pkg.kind === kind
	);

	const manifest = new AssetsManifestPlugin(
		MANIFEST_FILENAMES[ kind ],
		Object.fromEntries(
			mine.map( ( [ name, pkg ] ) => [
				`${ SHARED_SEGMENT }/${ pkg.dir }`,
				// `id` is what WordPress registers it under: a module's npm name,
				// because that is the specifier the built JavaScript imports; a
				// script's declared handle, because that is what every importer's
				// own `.asset.php` already names.
				{
					kind: pkg.kind,
					id: pkg.kind === 'module' ? name : pkg.handle,
				},
			] )
		)
	);

	/*
	 * An entry goes to the compilation matching its own kind. Most are classic
	 * scripts; one declaring `"kind": "module"` is built as an ES module and
	 * can then only import what WordPress ships as a script module --
	 * `@wordpress/interactivity` is one, `@wordpress/element` is not, and
	 * webpack says so outright rather than building something broken.
	 */
	const own = Object.entries( ownEntries ).reduce(
		( found, [ name, entry ] ) =>
			entry.kind === kind ? { ...found, [ name ]: entry.file } : found,
		{}
	);

	// A build with no shared packages still gets a manifest — it describes every
	// entry, and `register_script_from_manifest()` reads it for all of them.
	if ( mine.length === 0 ) {
		return {
			...config,
			entry: ( ...args ) => ( {
				...( typeof config.entry === 'function'
					? config.entry( ...args )
					: config.entry ),
				...own,
			} ),
			plugins: [
				...config.plugins,
				new RemoveEmptyScriptsPlugin(),
				manifest,
			],
		};
	}

	const entries = mine.reduce(
		( found, [ , pkg ] ) => ( {
			...found,
			[ `${ SHARED_SEGMENT }/${ pkg.dir }` ]:
				kind === 'script'
					? // Per entry, not on `output`: only a shared package is a
					  // library, and each exposes the global it declared.
					  {
							import: pkg.entry,
							library: { name: pkg.global, type: 'window' },
					  }
					: pkg.entry,
		} ),
		{}
	);

	return {
		...config,

		output: {
			...config.output,

			// webpack resolves entries lazily, so a `library` appearing on one
			// only when the function runs is too late to enable its type. The
			// module build needs nothing here: its own output is already a
			// library of type `module`.
			...( kind === 'script'
				? { enabledLibraryTypes: [ 'window' ] }
				: {} ),
		},

		entry: ( ...args ) => {
			// The default is a function — it discovers blocks and `src/index`.
			const discovered =
				typeof config.entry === 'function'
					? config.entry( ...args )
					: config.entry;

			return { ...discovered, ...own, ...entries };
		},

		plugins: [
			// Replaced rather than appended: the default instance externalizes
			// WordPress's own packages and knows nothing about yours.
			...config.plugins.filter(
				( plugin ) =>
					plugin.constructor.name !==
					'DependencyExtractionWebpackPlugin'
			),
			new RemoveEmptyScriptsPlugin(),
			manifest,
			new DependencyExtractionWebpackPlugin(
				kind === 'script'
					? {
							requestToExternal: ( request ) =>
								shared[ request ]?.global,
							requestToHandle: ( request ) =>
								shared[ request ]?.handle,
					  }
					: {
							requestToExternalModule: ( request ) =>
								shared[ request ] ? request : undefined,
					  }
			),
		],
	};
}

module.exports = Array.isArray( defaults )
	? defaults.map( withShared )
	: withShared( defaults );
