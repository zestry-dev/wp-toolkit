declare( strict_types=1 );

namespace {{class_namespace}};

// Loaded by WordPress, never requested directly.
\defined( 'ABSPATH' ) || exit;

use {{copied_namespace}}\Kernel\Abstracts\Service;

class {{class_name}} extends Service {

	// Declare a public or protected typed property to have another service or
	// module injected automatically, e.g.:
	// public Path $path;

	/*
	 * A service is built the first time something asks for it -- a
	 * `$plugin->get( {{class_name}}::class )` call, or another class declaring a
	 * property of this type -- and does its work only when called. It needs no
	 * bootstrap.php entry for that.
	 *
	 * `bootstrap.php` is modules only, so a service that takes configuration gets
	 * it from `configure()` in your entry file. The callback runs once, when the
	 * service is first built:
	 *
	 * ```
	 * public function set_api_key( string $key ): void { ... }
	 *
	 * // my-plugin.php
	 * ( new Plugin( __FILE__ ) )
	 *     ->configure( {{class_name}}::class, static function ( {{class_name}} $service ): void {
	 *         $service->set_api_key( 'abc123' );
	 *     } )
	 *     ->bootstrap()
	 *     ->run();
	 * ```
	 *
	 * The constructor is final and takes no arguments, so that setter is how
	 * configuration arrives. A class that wants constructor arguments is a value
	 * object rather than a service: make it a plain class, and if it also needs
	 * the plugin, have it implement PluginAware, `use WithPlugin`, and pass it
	 * through `$this->get_plugin()->wire( $object )`.
	 *
	 * Needs to do something without being called -- bind a hook, register a post
	 * type, schedule a job? Then it is a module, not a service: run
	 * `wp zt make module {{class_name}}` instead and delete this file.
	 */
}
