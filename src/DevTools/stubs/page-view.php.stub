<?php
/**
 * Markup for the {{title}} admin page.
 *
 * Rendered by resources/admin-pages/{{name}}.php. Every variable here is one that file
 * passed -- nothing else of the page is in scope, so this template's inputs are
 * exactly what its render() call names.
 *
 * Escape on output, in the right context: esc_html() for text, esc_attr() for an
 * attribute, esc_url() for a URL.
 *
 * `$this` is the `views` module, so a subview is
 * `$this->render( 'admin-pages/-fields', array( ... ) )`. The `@var` below is
 * what makes an editor complete it -- a template is included, not called, so
 * nothing else tells your editor what `$this` is here.
 *
 * @var \{{copied_namespace}}\Modules\Views $this
 * @var string $title  The page title.
 * @var string $action Where this page's form posts to.
 * @var string $nonce  The nonce action scoping it.
 * @var string $notice What the request before this one left to say, if anything.
 */

declare( strict_types=1 );

// Loaded by the `views` module, never requested directly.
defined( 'ABSPATH' ) || exit;

?>
<div class="wrap">
	<h1><?php echo esc_html( $title ); ?></h1>

	<?php if ( '' !== $notice ) : ?>
		<?php // Left by handle_submit() before it redirected. Keeping the markup ?>
		<?php // here rather than in the page class keeps it all in one file. ?>
		<div class="notice notice-success is-dismissible">
			<p><?php echo esc_html( $notice ); ?></p>
		</div>
	<?php endif; ?>

	<form method="post" action="<?php echo esc_url( $action ); ?>">
		<?php wp_nonce_field( $nonce ); ?>

		<table class="form-table" role="presentation">
			<tr>
				<th scope="row">
					<label for="{{name}}-example"><?php esc_html_e( 'Example', '{{text_domain}}' ); ?></label>
				</th>
				<td>
					<input type="text" name="example" id="{{name}}-example" class="regular-text" value="" />
				</td>
			</tr>
		</table>

		<?php submit_button(); ?>
	</form>
</div>
