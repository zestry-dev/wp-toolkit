/**
 * What every {{class_name}} shares.
 *
 * Put here what would otherwise be repeated in each file: a method every one of
 * them answers the same way, a helper they all reach for, a property the plugin
 * writes once. Leave abstract what each one has to decide for itself, and the
 * generator fills those in:
 *
 * ```bash
 * wp zt make {{type}} example --extends={{class_name}}
 * ```
 */
abstract class {{class_name}}{{extends}} {

	// Reach any declared module with `$this->with( Path::class )` -- here, or in
	// any file extending this.

	// An abstract method here is one each file must answer. A concrete one is an
	// answer they all share, and the reason this class exists.
}
